# ============================================
# PRONT Revisor - .gitignore
# ============================================

# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment variables - CRITICAL: never commit real secrets
.env
.env.local
.env.*.local
.env.development.local
.env.production.local

# Database files (local development)
*.db
*.db-journal
*.sqlite
*.sqlite3
dev.db
prisma/dev.db

# Local file uploads (use Railway Volume in production)
uploads/
data/

# TypeScript build info
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Misc build / cache
dist/
build/
coverage/
.vercel/
.turbo/

# Railway specific (optional local config)
railway.json

# Personal skill/tooling folders (not part of the project)
.agents/
.claude/
skills-lock.json

# Windows specific
$null
-p/
