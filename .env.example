# ============================================
# PRONT Revisor - Environment Variables
# Copy this file to .env.local and fill the values
# ============================================

# Database (Railway PostgreSQL recommended)
DATABASE_URL="postgresql://user:password@host:port/railway?sslmode=require"
# Use Railway internal connection for DIRECT_URL (better for migrations)
DIRECT_URL="postgresql://user:password@postgres.railway.internal:5432/railway"

# Auth.js
NEXTAUTH_URL="https://your-app.up.railway.app"
NEXTAUTH_SECRET="generate-a-long-random-string-here-at-least-32-chars"

# AI Providers (at least one recommended for real analysis)
XAI_API_KEY="your_xai_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# File uploads on Railway
# Create a Volume in Railway and mount it (example mount path: /data/uploads)
# Then set this variable:
UPLOADS_DIR=/data/uploads

# ============================================
# Production Notes (Railway)
# ============================================
# - Use Railway Postgres public URL for DATABASE_URL
# - Use Railway internal URL for DIRECT_URL (for migrations)
# - Set a strong NEXTAUTH_SECRET
# - Set UPLOADS_DIR to your Volume mount path
# - For full deploys, connect GitHub repo in Railway for automatic deployments
# - After first deploy, run: npx prisma migrate deploy
